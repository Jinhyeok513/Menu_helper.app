# 선택 사항: 저장 JSON 조회 기능을 사용할 때만 로컬 파일 경로를 설정한다.
# URL·QR·사진 메뉴 기능과 Render 서버 시작에는 이 파일이 필요하지 않다.
MENU_JSON_PATH=

# V1.1 서버 메뉴 스냅샷 저장소. 실제 URL과 비밀번호는 로컬 .env 또는
# Render Secret 환경변수에만 설정한다.
DATABASE_URL=
MENU_DATABASE_CONNECT_TIMEOUT_SECONDS=5
MENU_DATABASE_STATEMENT_TIMEOUT_MS=10000
MENU_SOURCE_ARTIFACT_MAX_BYTES=2000000
MENU_SOURCE_ARTIFACT_MAX_COMPRESSED_BYTES=750000

# 휴대폰에서 접속하려면 0.0.0.0으로 실행하고 PC의 LAN IP를 앱에 설정한다.
MENU_API_HOST=0.0.0.0
MENU_API_PORT=8000

# 운영 기본값은 false다. 로컬 fixture 서버 연습에서만 true로 바꾼다.
MENU_ALLOW_PRIVATE_URLS=false

# 비어 있으면 공개 HTTP(S) 호스트를 허용한다. 운영에서는 지원 도메인을 쉼표로 제한한다.
MENU_ALLOWED_HOSTS=
MENU_FETCH_TIMEOUT_SECONDS=10
MENU_MAX_HTML_BYTES=2000000

# 실제 키를 이 파일에 넣지 않는다.
GROQ_API_KEY=

# 한국어 메뉴 설명 모델. 공식 Groq 모델 ID를 사용한다.
MENU_TEXT_MODEL=openai/gpt-oss-20b

# 메뉴판 사진 추출 모델. 실제 모델을 바꿀 때만 덮어쓴다.
MENU_VISION_MODEL=qwen/qwen3.8-27b

# 외부 AI 요청이 메뉴 사용을 무기한 막지 않도록 제한한다.
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=0

# V1/V2 성능 비교용 개발 로그. 실제 URL·메뉴 내용·API 키는 기록하지 않는다.
MENU_PERFORMANCE_LOG_ENABLED=false
MENU_PERFORMANCE_LOG_PATH=performance_logs/v1_events.jsonl
# 비교 실행마다 같은 값을 지정하면 한 측정 세션으로 식별하기 쉽다.
MENU_PERFORMANCE_SESSION_ID=
# 배포·커밋 버전을 명시하지 않으면 현재 Git 커밋(+dirty)을 자동 기록한다.
MENU_CODE_VERSION=
