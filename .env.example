# 저장소에 포함되지 않은 실제 메뉴 JSON의 로컬 경로
MENU_JSON_PATH=/absolute/path/to/Noelles_Cafe_Menu.json

# 휴대폰에서 접속하려면 0.0.0.0으로 실행하고 PC의 LAN IP를 앱에 설정한다.
MENU_API_HOST=0.0.0.0
MENU_API_PORT=8000

# 운영 기본값은 false다. 로컬 fixture 서버 연습에서만 true로 바꾼다.
MENU_ALLOW_PRIVATE_URLS=false

# 비어 있으면 공개 HTTP(S) 호스트를 허용한다. 운영에서는 지원 도메인을 쉼표로 제한한다.
MENU_ALLOWED_HOSTS=
MENU_FETCH_TIMEOUT_SECONDS=10
MENU_MAX_HTML_BYTES=2000000

# 실제 키를 이 파일에 넣지 않는다.
GROQ_API_KEY=
