{
  "expo": {
    "name": "Menu Helper",
    "slug": "menu-helper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jinhyeok.menuhelper",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Menu Helper가 같은 Wi-Fi의 개발용 메뉴 서버에 연결하도록 로컬 네트워크 접근을 허용해 주세요."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.jinhyeok.menuhelper",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Menu Helper가 메뉴 QR 코드를 스캔하고 메뉴판을 촬영하도록 카메라 접근을 허용해 주세요.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Menu Helper가 메뉴판 사진을 선택하도록 사진 접근을 허용해 주세요.",
          "cameraPermission": "Menu Helper가 메뉴 QR 코드를 스캔하고 메뉴판을 촬영하도록 카메라 접근을 허용해 주세요.",
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
